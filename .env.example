FROM_EMAIL=tu_email@aqui.com

# Frontend URLs
URL_FRONTEND=http://localhost:3000/#'
URL_SERVER=http://localhost:4500/api

# Google Drive API
GOOGLE_DRIVE_API_KEY=repfora-c966104279a7.json

# SOFIA Plus Configuration
SOFIA_URL=http://senasofiaplus.edu.co/sofia-public/
