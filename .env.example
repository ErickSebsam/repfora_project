# Database
MONGO_URL=mongodb://mongo:27017/Horarios_SENA

# Backup Database Configuration
# Los backups se hacen de MONGO_URL y se suben automáticamente a Google Drive
# en la carpeta "database-backups".
# Se eliminan backups locales después de 7 días y de Drive después de 15 días.
# Backup automático: diariamente a las 3:00 AM

# Server
PORT=4500
NODE_ENV=production

# JWT
JWT_SECRET=tu_clave_secreta_aqui

# Email Configuration
