{
  "name": "horarios_sena",
  "version": "1.0.0",
  "description": "Aplicativo web para manejar la programación de horarios de las fichas del SENA",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "format": "prettier --write .",
    "postinstall": "npx playwright install chromium --with-deps",
    "docs:generate": "node scripts/generate-postman.js",
    "docs:watch": "nodemon --watch routes --exec 'npm run docs:generate'"
  },
  "license": "ISC",
  "dependencies": {
    "archiver": "^5.3.1",
    "axios": "^1.4.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-fileupload": "^1.4.0",
    "express-validator": "^6.15.0",
    "googleapis": "^171.4.0",
    "handlebars": "^4.7.7",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "playwright": "^1.56.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tinify": "^1.7.1",
    "uuid": "^14.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "nodemon": "^3.1.14"
  }
}
